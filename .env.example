# OpenAI
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# SendGrid
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY

# Newsletter settings
FROM_NAME=Matt Gage Digital
FROM_EMAIL=matt@mattgage.net
TO_EMAIL=matt@mattgage.net

# Content controls
TOP_N=8
MIN_SCORE=0.35

# Optional: override feeds (comma-separated URLs). If empty, uses src/feeds.py defaults.
FEED_URLS=

# -------------------------------------------------------
# Site Monitor + SMS Alerts
# -------------------------------------------------------
# Twilio credentials — https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# Your cell phone number to receive SMS alerts
ALERT_TO_NUMBER=+1xxxxxxxxxx

# How often to check sites (minutes, default 30)
CHECK_INTERVAL_MINUTES=30

# Flask secret key for session signing
SECRET_KEY=change-me-to-something-random
